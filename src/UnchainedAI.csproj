<Project Sdk="Microsoft.NET.Sdk">
  <!-- UNCHAINED AI – Zusatz-KI für den WindBot von EDOPro. Ausgabe: UnchainedAI.dll → ProjectIgnis\WindBot\Executors -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>UnchainedAI</AssemblyName>
    <RootNamespace>WindBot.Game.AI.Decks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>2026.11.05</Version>
    <Authors>Keto Saiba</Authors>
    <!-- Getestete Fassung: die Versuchs-Regeln bleiben aus -->
    <DefineConstants>$(DefineConstants);OHNE_SCHNELLPLAN;OHNE_KLEINWERT;OHNE_ABOMWERT;OHNE_BANISH;OHNE_DODGE;OHNE_SOULRAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- ExecutorBase.dll aus dem eigenen EDOPro-Ordner (ProjectIgnis\WindBot) nach src\lib kopieren -->
    <Reference Include="ExecutorBase">
      <HintPath>lib\ExecutorBase.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
